# =============================================================================
# Vend-A-Shu server environment variables
# Copy to .env and fill in values. Never commit .env to version control.
# Do not prefix secrets with EXPO_PUBLIC_ — those are bundled into the mobile app.
# =============================================================================

# --- Express API (required today) ---

# PostgreSQL connection string for users, shoes, and bins
DATABASE_URL=postgres://vas:choose-a-password@localhost:5432/vendashu

# Port the API server listens on
PORT=8080

# Node environment
NODE_ENV=development

# --- Supabase hardware command queue (required in a later integration phase) ---

# Supabase project URL (server-side only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key — used by Express to enqueue device_commands.
# Never use the anon key here. Never expose this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Device id written into device_commands rows; must match the Pi worker.
# Use vend-a-shoe-test for staging/dry-run; production Pi uses a different id.
DEVICE_ID=vend-a-shoe-test

# --- Pi worker (hardware/pi/.env on the Raspberry Pi) ---

# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# DEVICE_ID=vend-a-shoe-001

# --- Optional (future integration phases) ---

# Skip Supabase command inserts during staging/local API testing (recommended for Vercel preview)
HARDWARE_DRY_RUN=true

# Documented in docs/raspberry-pi-setup.md but not used by current API code
# SESSION_SECRET=generate-with-openssl-rand-hex-32
